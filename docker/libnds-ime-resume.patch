libnds: turn IME back on whenever a thread is resumed

libnds 426b9c98 dropped this line from the context switch. On a real console an interrupt that is already arriving can
still be taken just after a critical section has written IME = 0; libnds
then preempts, and the thread it switches to runs with IME 0. On the ARM7
that thread is the FIFO one, which reads the SD card for the ARM9 in DSi
mode: with no interrupts, map loads hang (seen on a 3DS in DSi mode; melonDS
does not take that interrupt). Applied to the pinned libnds until BlocksDS
fixes it upstream (docker/Dockerfile, docker/versions.env).

diff --git a/source/common/cothread/context.s b/source/common/cothread/context.s
--- a/source/common/cothread/context.s
+++ b/source/common/cothread/context.s
@@ -45,6 +45,13 @@
     bic     r1, r1, #CPSR_FLAG_IRQ_DIS
     msr     spsr, r1
 
+    // Enable IME as well: a thread can be preempted by an interrupt taken
+    // just after it wrote IME = 0, and the next thread would run with every
+    // interrupt off.
+    mov     r3, #0x4000000
+    mov     r4, #1
+    str     r4, [r3, #0x208]
+
     ldr     lr, [r0, #COTHREAD_INFO_CPU_PC_OFFSET]
 
     ldmia   r0, {r0-r12}
