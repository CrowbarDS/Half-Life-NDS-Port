# The exact version of everything the build takes from elsewhere. The image is
# rebuilt only when something in docker/ changes (.github/workflows), and a
# change here is the way to move to a newer one. (The BlocksDS image itself is
# pinned at the top of the Dockerfile: a FROM line cannot read this file.)
NEA_REPO=https://github.com/Warioware64/nitro-engine.git
NEA_COMMIT=ea56eac0840b128b84ae6f9159c497ae6e874b44
DSWIFI_REPO=https://github.com/Warioware64/dswifi.git
DSWIFI_COMMIT=0c7a56a7cdc02369509e709ac406a4f374b09028
TEAK_LLVM_REPO=https://github.com/Warioware64/teak-llvm.git
TEAK_LLVM_COMMIT=1ef439c1f2f647255f9c604ddd61b95c4b96a879
LIBTEAK_REPO=https://github.com/Warioware64/libteak.git
LIBTEAK_COMMIT=2191cf2b3b05ee23987b5b19a803d1e7c2341a52
PTEXCONV_REPO=https://github.com/Garhoogin/ptexconv.git
PTEXCONV_COMMIT=fa6549d9f382f24dbee17dc58eff24e390ba0a18
NINJA_VERSION=1.13.2
PILLOW_VERSION=12.3.0
AQT_VERSION=3.3.0
QT_VERSION=6.8.3
