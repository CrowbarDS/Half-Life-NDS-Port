 const int kDataCacheTiming = 3;//2;
 const int kCodeCacheTiming = 3;//5;
 
+// HLDS I-cache profiler (Half-Life NDS port, tools only): per 32-byte line of
+// main RAM (all 16 MB of a DSi's), how often code entered the line (a lookup)
+// and how often it missed, by the phase of the frame the game said it was in
+// (a write to 0x04FFFA2C: HlSetIcachePhase, NDS.cpp; 0 until one is made).
+// Code run in IRQ mode is counted under phase 15 whatever. With
+// HLDS_ICACHE_OUT set, a snapshot of the counts so far is written every 2^26
+// lookups to $HLDS_ICACHE_OUT.<n> ("addr phase lookups misses" in hex, lines
+// with any; its head says how many frames had begun: a write of phase 8, the
+// game's Frame, straight after 0), so that a scene is the difference of two
+// snapshots.
+namespace
+{
+constexpr u32 kHlLines = 0x1000000 >> 5; // 16 MB of main RAM
+constexpr u32 kHlPhases = 16;
+constexpr u32 kHlIrqPhase = 15;
+u32* hlLookups = nullptr; // [phase][line]
+u32* hlMisses = nullptr;
+u32 hlPhase = 0;
+u64 hlFrames = 0;
+u64 hlTotal = 0;
+int hlSnapshot = 0;
+const char* hlOut = nullptr;
+bool hlChecked = false;
+
+void hlWriteSnapshot()
+{
+    char name[1024];
+    snprintf(name, sizeof(name), "%s.%d", hlOut, hlSnapshot++);
+    FILE* f = fopen(name, "w");
+    if (!f) return;
+    fprintf(f, "# lookups %llu phases frames %llu\n", (unsigned long long)hlTotal, (unsigned long long)hlFrames);
+    for (u32 p = 0; p < kHlPhases; p++)
+        for (u32 i = 0; i < kHlLines; i++)
+        {
+            const u32 at = p * kHlLines + i;
+            if (hlLookups[at] || hlMisses[at])
+                fprintf(f, "%08x %x %x %x\n", 0x02000000u + (i << 5), p, hlLookups[at], hlMisses[at]);
+        }
+    fclose(f);
+}
+
+inline void hlCount(u32 addr, bool miss, u32 cpsr)
+{
+    if (!hlChecked)
+    {
+        hlChecked = true;
+        hlOut = getenv("HLDS_ICACHE_OUT");
+        if (hlOut)
+        {
+            hlLookups = (u32*)calloc((size_t)kHlPhases * kHlLines, sizeof(u32));
+            hlMisses = (u32*)calloc((size_t)kHlPhases * kHlLines, sizeof(u32));
+            if (!hlLookups || !hlMisses) hlOut = nullptr;
+        }
+    }
+    if (!hlOut || (addr & 0xFF000000) != 0x02000000) return;
+    const u32 phase = (cpsr & 0x1F) == 0x12 ? kHlIrqPhase : hlPhase;
+    const u32 i = phase * kHlLines + ((addr & 0xFFFFFF) >> 5);
+    if (miss) { hlMisses[i]++; return; }
+    hlLookups[i]++;
+    if ((++hlTotal & ((1u << 26) - 1)) == 0) hlWriteSnapshot();
+}
+}
+
+// (NDS.cpp: the game's write to 0x04FFFA2C.)
+void HlSetIcachePhase(u32 phase)
+{
+    if (phase == 8 && hlPhase == 0)
+        hlFrames++;
+    hlPhase = phase < kHlPhases ? phase : 0;
+}
 
