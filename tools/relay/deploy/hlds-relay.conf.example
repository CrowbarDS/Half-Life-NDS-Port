# The relay's options, read by hlds-relay.service. Installed as
# /etc/hlds-relay.conf (install.sh does it, unless it is there already).
# After a change: sudo systemctl restart hlds-relay
#
# hlds-relay --help lists them all. A few:
#   --port 27500                   the UDP port (open it in the firewall too)
#   --log-ips trunc                trunc (default), hash, or full
#   --limit out-bytes-per-s=N      what the server's link may carry, in bytes a second
#   --limit silent-seconds=210     how long a quiet console is waited for

HLDS_RELAY_ARGS=--port 27500 --log-ips trunc
